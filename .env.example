# ==============================================================================
# TELEGRAM UPLOADER - VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como .env y completa tus valores reales.
# ==============================================================================

# Credenciales API Telegram (Obligatorias - obtenidas en my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_GROUP_ID=

# Notificaciones y Bot interactivo (Opcionales)
TELEGRAM_NOTIFY_CHANNEL_ID=
TELEGRAM_NOTIFY_THREAD_ID=
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# Metadatos TMDb (Opcional - themoviedb.org)
TMDB_API_KEY=
TMDB_LANGUAGE=es-ES

# Empaquetado y Cifrado
COMPRESS_FILES=true
ARCHIVE_PASSWORD=
ARCHIVE_VOLUME_SIZE=1850m
SPLIT_THRESHOLD_GB=

# Cuota diaria (GB)
DAILY_QUOTA_GB=100.0

# Planificación y Antigüedad de archivos
RUN_AT=
RUN_INTERVAL_HOURS=24.0
MIN_FILE_AGE_MINUTES=10.0
MAX_CONSECUTIVE_FAILURES=10

# Entorno y Rutas
HOST_MEDIA_PATH=/mnt/user/data/media/tv/
MEDIA_DIR=/media
DATA_DIR=/data
TEMP_DIR=/tmp/splits
TZ=Europe/Madrid
LOG_LEVEL=INFO

# Rutas del Host para docker-compose.yml
DATA_PATH=/mnt/user/appdata/telegram-uploader/data
MEDIA_PATH=/mnt/user/data/media/tv
TEMP_PATH=/tmp/splits
